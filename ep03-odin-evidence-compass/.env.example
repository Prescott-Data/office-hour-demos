# Direct Azure OpenAI provider for agent.py
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_API_VERSION=2025-04-01-preview
AZURE_DEPLOYMENT=gpt-5.4

# Each turn is one small JSON action. A provider length stop fails the mission;
# partial output is never accepted as an action.
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MODEL_INPUT_CHAR_LIMIT=1000000
