# Copy to .env and fill in. Everything here is optional: the control room and
# beats 1, 2 and 3 run with no keys at all.

# ── Redis ─────────────────────────────────────────────────────────────────────
# The control room's workers and dashboard. beat1 always uses localhost:6379.
CR_REDIS_URL=redis://localhost:6379/0
CR_PORT=8090

# ── Live model (optional) ─────────────────────────────────────────────────────
# Only for the dashboard's "Live model" toggle and beat3_failover.py.
# Without these, the summary step uses the local fake providers.
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_DEPLOYMENT=gpt-4o
AZURE_API_VERSION=2025-01-01-preview

# ── Local fallback model (optional, beat3_failover.py only) ──────────────────
LOCAL_LLM_ENDPOINT=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2:3b
