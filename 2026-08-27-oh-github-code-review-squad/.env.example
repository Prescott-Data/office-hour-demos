# Copy to .env and fill in. Nothing here is committed — .env is gitignored.

# ── Nexus ─────────────────────────────────────────────────────────────────────
NEXUS_GATEWAY_URL=          # your Nexus gateway (see the README)
NEXUS_RETURN_URL=http://localhost:9090/callback
REDIS_URL=redis://localhost:6379/0

# Captured from a previous run so a restart doesn't re-open the consent screen.
# push_and_open_pr.py prints these when consent completes.
NEXUS_GITHUB_CONNECTION_ID=
NEXUS_GOOGLE_CONNECTION_ID=

# ── The repo the agents push to ───────────────────────────────────────────────
# Must be public: the gateway's GitHub app carries public_repo, not repo.
DEMO_GITHUB_OWNER=
DEMO_GITHUB_REPO=code-review-squad-sandbox
DEMO_BASE_BRANCH=main

# ── Google ────────────────────────────────────────────────────────────────────
# The gateway already has a Google OAuth client registered against
# "google-workspace", so there is nothing to create in the Google Cloud console.
# Override only if you registered your own provider profile.
DEMO_GOOGLE_PROVIDER=google-workspace

# ── Who sends, who receives ───────────────────────────────────────────────────
# Whoever completes the Google consent is the sender.
DEMO_SENDER_NAME=
DEMO_RECIPIENT=

# ── LLM (one of these) ────────────────────────────────────────────────────────
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_DEPLOYMENT=gpt-4o
